# ---------------------------------------------------------------------------
# API server (artifacts/api-server)
# ---------------------------------------------------------------------------

# Neon: use the *pooled* connection string here (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/healers?sslmode=require
# Neon: the direct (non-pooled) endpoint, used only for migrations.
DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/healers?sslmode=require
# Set to "true" to force TLS when the URL has no sslmode parameter.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# Railway sets PORT automatically; only needed for local runs.
PORT=8080
# The public HTTPS origin of the API (Railway domain or custom domain).
PUBLIC_API_URL=https://api.example.com

# Clerk (https://dashboard.clerk.com -> API keys)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Optional: PEM public key for networkless JWT verification.
# CLERK_JWT_KEY=
# Clerk dashboard -> Webhooks -> endpoint https://<PUBLIC_API_URL>/api/webhooks/clerk
# Subscribe to user.created, user.updated, user.deleted.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# Email (Resend). Without it, reminder emails are written to the log.
RESEND_API_KEY=
EMAIL_FROM="Healers Inc <hello@example.com>"

# Payments (Stripe Connect). Leave PAYMENTS_ENABLED=false to skip Stripe entirely.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=sk_test_xxx
# Optional: the sync layer registers its own webhook at
# <PUBLIC_API_URL>/api/webhooks/stripe on first boot and stores the secret.
STRIPE_WEBHOOK_SECRET=
PAYMENT_PLATFORM_FEE_BPS=1000
PAYMENT_SUPPORTED_COUNTRIES=CA,US,GB,AU
# Where Expo *web* checkout returns to (the healers-app web deployment).
PAYMENT_WEB_RETURN_BASE_URL=https://app.example.com
# Extra web origins Stripe Checkout may return to (comma-separated HTTPS base URLs).
# Set this to the Healers Inc web site origin so its "Pay securely" flow is accepted;
# http://localhost:* entries are honoured only outside production.
PAYMENT_WEB_RETURN_ALLOWED_BASE_URLS=https://healers.example,http://localhost:5173

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Expo app (artifacts/healers-app) — EXPO_PUBLIC_* values are baked into the bundle
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
