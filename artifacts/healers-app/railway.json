{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @workspace/healers-app run build:web"
  },
  "deploy": {
    "startCommand": "node artifacts/healers-app/server/serve-web.js",
    "healthcheckPath": "/",
    "numReplicas": 1
  }
}
