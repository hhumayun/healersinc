# Copy to .env.local for local development (both values are safe to expose to browsers).
# Base URL of the API server; leave empty when the site is served behind the same origin.
VITE_API_URL=https://api-production-e751.up.railway.app
# Clerk publishable key for the SAME Clerk instance the mobile app uses.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
