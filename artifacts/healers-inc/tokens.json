{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f7f7f8" },
      "foreground": { "$value": "#1d2130" },
      "border": { "$value": "#e4e4e7" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#1d2130" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#1d2130" },
      "primary": {
        "$value": "#f28500",
        "$description": "Healers Inc brand orange. Drives primary CTAs (Sign In, Chat Now, Send Booking Request), active pills, and emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": {
        "$value": "#fbd6aa",
        "$description": "Soft peach brand surface, used for highlighted chips and warm secondary emphasis."
      },
      "secondaryForeground": { "$value": "#6b3d00" },
      "muted": { "$value": "#efeff1" },
      "mutedForeground": { "$value": "#6b7280" },
      "accent": {
        "$value": "#2379ea",
        "$description": "Utility blue seen on links, search actions, checkboxes, and selected states."
      },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#d6403a" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d6d6db" },
      "ring": { "$value": "#f28500" },
      "chart1": { "$value": "#f28500" },
      "chart2": { "$value": "#2379ea" },
      "chart3": { "$value": "#e0491c" },
      "chart4": { "$value": "#f2bb6b" },
      "chart5": { "$value": "#4c9a6a" },
      "sidebar": { "$value": "#ffffff" },
      "sidebarForeground": { "$value": "#3f4254" },
      "sidebarBorder": { "$value": "#e4e4e7" },
      "sidebarPrimary": { "$value": "#f28500" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#fdeedc" },
      "sidebarAccentForeground": { "$value": "#6b3d00" },
      "sidebarRing": { "$value": "#f28500" }
    },
    "dark": {
      "background": { "$value": "#17140f" },
      "foreground": { "$value": "#f5f1e9" },
      "border": { "$value": "#322c22" },
      "card": { "$value": "#1f1b15" },
      "cardForeground": { "$value": "#f5f1e9" },
      "popover": { "$value": "#1f1b15" },
      "popoverForeground": { "$value": "#f5f1e9" },
      "primary": { "$value": "#f28500" },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#3d2c17" },
      "secondaryForeground": { "$value": "#fbd6aa" },
      "muted": { "$value": "#2a251d" },
      "mutedForeground": { "$value": "#a69f92" },
      "accent": { "$value": "#3f8cff" },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#e5484d" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#3a3327" },
      "ring": { "$value": "#f28500" },
      "chart1": { "$value": "#f79422" },
      "chart2": { "$value": "#5c9df5" },
      "chart3": { "$value": "#f2593d" },
      "chart4": { "$value": "#f7c873" },
      "chart5": { "$value": "#6fbf8a" },
      "sidebar": { "$value": "#1c1812" },
      "sidebarForeground": { "$value": "#ede7dc" },
      "sidebarBorder": { "$value": "#322c22" },
      "sidebarPrimary": { "$value": "#f28500" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#2c2619" },
      "sidebarAccentForeground": { "$value": "#f5f1e9" },
      "sidebarRing": { "$value": "#f28500" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Healers Inc brand typeface for all UI and body text."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme. Cards and media use generous rounding; hero CTAs are fully rounded pills."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
